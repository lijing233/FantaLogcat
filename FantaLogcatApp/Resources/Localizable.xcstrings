    },
    "Downloading and verifying Android tools…" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在下载并校验 Android 工具…"
          }
        }
      }
    },
    "English" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英语"
          }
        }
      }
    },
    "Error: %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错误：%@"
          }
        }
      }
    },
    "FantaLogcat downloads the official Google Platform-Tools package (about 16 MB), verifies its SHA-256 checksum, and keeps it inside the app support folder." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FantaLogcat 会下载 Google 官方 Platform-Tools（约 16 MB），校验 SHA-256，并仅保存在应用支持目录中。"
          }
        }
      }
    },
    "Keep FantaLogcat open. The existing installation will not be replaced unless verification succeeds." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请保持 FantaLogcat 开启。只有校验成功后才会替换现有安装。"
          }
        }
      }
    },
    "Keep up to %@ logs per new session" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单次会话最多保留 %@ 条日志"
          }
        }
      }
    },
