    },
    "Accept and install" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接受并安装"
          }
        }
      }
    },
    "Chinese is the default. This preference stays on this Mac." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用简体中文；该设置仅保存在本机。"
          }
        }
      }
    },
    "Close" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭"
