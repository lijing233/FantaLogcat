        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FantaLogcat 会下载 Google 官方 Platform-Tools（约 16 MB），校验 SHA-256，并仅保存在应用支持目录中。"
          }
        }
      }
    },
    "Keep FantaLogcat open. The existing installation will not be replaced unless verification succeeds." : {
